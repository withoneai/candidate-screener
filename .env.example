# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection keys from `one --agent list` (the `key` field for each)
ONE_CONNECTION_WORKABLE=
ONE_CONNECTION_GMAIL=

# The job to screen: its shortcode is in the job's URL in Workable
# (https://<you>.workable.com/backend/jobs/<id>/...) or in `npm run check`
WORKABLE_JOB_SHORTCODE=

# Optional: the Workable member the screening comment is posted as.
# Without it, the reasoning is printed and drafted but no comment is left
# on the candidate. `npm run check` lists the job's hiring team with ids.
# WORKABLE_MEMBER_ID=

# Optional: which stage counts as "new" (default: applied)
# SCREEN_STAGE=applied

# Optional: override the Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
